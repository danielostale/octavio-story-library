# OpenAI API (server-side only)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Auth.js / Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: comma-separated emails allowed to access this private family app
ALLOWED_EMAILS=

# Child profile. The app uses this to calculate an age-appropriate default duration.
CHILD_NAME=Octavio
CHILD_BIRTH_DATE=YYYY-MM-DD

# Drive root folder name
DRIVE_ROOT_FOLDER=Octavio Story Library
