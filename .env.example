# Gemini API - free tier
# Create at Google AI Studio. Keep the real key only in Netlify/StackBlitz secrets.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite

# Auth.js / Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: comma-separated emails allowed to access the family app
ALLOWED_EMAILS=

# Child profile
CHILD_NAME=Octavio
CHILD_BIRTH_DATE=YYYY-MM-DD

# Drive root folder name
DRIVE_ROOT_FOLDER=Octavio Story Library
